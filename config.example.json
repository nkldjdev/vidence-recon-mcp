{
  "scope": {
    "allowedTargets": ["localhost", "127.0.0.1", "scanme.nmap.org"]
  },
  "safety": {
    "allowActive": true,
    "allowIntrusive": false,
    "allowRawArgs": false,
    "minIntervalMs": 0
  },
  "verification": {
    "required": true,
    "secret": "CHANGE-ME — run: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "methods": ["dns", "http"],
    "cacheTtlSec": 3600
  },
  "limits": {
    "commandTimeoutSec": 300,
    "maxOutputBytes": 1048576
  },
  "runner": {
    "mode": "local",
    "container": "vidence-kali",
    "dockerPath": "docker",
    "image": "ghcr.io/nkldjdev/vidence-recon-mcp:latest",
    "autostart": true
  },
  "tools": {
    "nmap": "nmap",
    "nuclei": "nuclei"
  }
}
